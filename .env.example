POSTGRES_DB=mini_erp
POSTGRES_USER=mini_erp_local
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DATABASE_URL="postgresql://mini_erp_local:replace_with_a_local_password@127.0.0.1:5432/mini_erp?schema=public"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

DEV_USER_EMAIL=developer@example.test
DEV_USER_NAME="Local Developer"
DEV_USER_PASSWORD=
# Optional local demo company settings; these are the script defaults.
DEV_TENANT_ID=7e1df07a-5b96-4c66-9d27-6471c55b7020
DEV_TENANT_NAME="Demo IT Supplies"

# Optional full-container mode: use the same credentials, with Docker service hostname db.
CONTAINER_DATABASE_URL="postgresql://mini_erp_local:replace_with_a_local_password@db:5432/mini_erp?schema=public"
APP_PORT=3000
