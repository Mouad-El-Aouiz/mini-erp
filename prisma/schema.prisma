generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Must contain a non-whitespace character; enforced by tenants_name_not_blank in SQL.
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  customers   Customer[]
  products    Product[]

  @@map("tenants")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships Membership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum MembershipRole {
  ADMIN
  EMPLOYEE
}

model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id")
  role      MembershipRole @default(EMPLOYEE)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  stockMovements StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Must contain a non-whitespace character; enforced by customers_company_name_not_blank in SQL.
  companyName String   @map("company_name")
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, companyName, id])
  @@map("customers")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Uppercase ASCII SKU; enforced by products_sku_format in SQL.
  sku            String
  /// Non-blank name; enforced by products_name_not_blank in SQL.
  name           String
  /// Tax-exclusive USD cents, from 0 to 2147483647; SQL rejects negative values.
  unitPriceCents Int      @map("unit_price_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  inventoryBalance InventoryBalance?
  stockMovements   StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, name, id])
  @@map("products")
}

model InventoryBalance {
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  /// Nonnegative physical units; enforced by inventory_physical_non_negative in SQL.
  physicalQuantity Int      @default(0) @map("physical_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, productId])
  @@map("inventory_balances")
}

model StockMovement {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  requestId              String   @map("request_id") @db.Uuid
  /// Nonzero signed units; enforced by stock_movements_delta_non_zero in SQL.
  quantityDelta          Int      @map("quantity_delta")
  reason                 String
  recordedByMembershipId String   @map("recorded_by_membership_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  recordedBy Membership @relation(fields: [tenantId, recordedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, requestId])
  @@index([tenantId, productId, createdAt, id])
  @@index([tenantId, recordedByMembershipId])
  @@map("stock_movements")
}
