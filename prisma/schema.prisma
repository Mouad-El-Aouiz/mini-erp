generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Must contain a non-whitespace character; enforced by tenants_name_not_blank in SQL.
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxRateBps Int     @default(1000) @map("tax_rate_bps")
  taxVersion Int     @default(1) @map("tax_version")
  orders     Order[]

  memberships Membership[]
  customers   Customer[]
  products    Product[]

  @@map("tenants")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships Membership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum MembershipRole {
  ADMIN
  EMPLOYEE
}

model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id")
  role      MembershipRole @default(EMPLOYEE)
  version   Int            @default(1)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  cancellationsRecorded Cancellation[]
  deliveriesRecorded    Delivery[]
  ordersConfirmed       Order[]         @relation("ConfirmedBy")
  ordersCreated         Order[]
  stockMovements        StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Must contain a non-whitespace character; enforced by customers_company_name_not_blank in SQL.
  companyName String   @map("company_name")
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  orders Order[]

  @@unique([tenantId, id])
  @@index([tenantId, companyName, id])
  @@map("customers")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Uppercase ASCII SKU; enforced by products_sku_format in SQL.
  sku            String
  /// Non-blank name; enforced by products_name_not_blank in SQL.
  name           String
  /// Tax-exclusive USD cents, from 0 to 2147483647; SQL rejects negative values.
  unitPriceCents Int      @map("unit_price_cents")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservations     StockReservation[]
  orderItems       OrderItem[]
  inventoryBalance InventoryBalance?
  stockMovements   StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, name, id])
  @@map("products")
}

model InventoryBalance {
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  /// Nonnegative physical units; enforced by inventory_physical_non_negative in SQL.
  physicalQuantity Int      @default(0) @map("physical_quantity")
  /// Between zero and physicalQuantity; updated atomically with reservations.
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, productId])
  @@map("inventory_balances")
}

enum StockMovementKind {
  ADJUSTMENT
  DELIVERY
}

model StockMovement {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  productId              String            @map("product_id") @db.Uuid
  requestId              String            @map("request_id") @db.Uuid
  /// Nonzero signed units; enforced by stock_movements_delta_non_zero in SQL.
  quantityDelta          Int               @map("quantity_delta")
  kind                   StockMovementKind @default(ADJUSTMENT)
  orderId                String?           @map("order_id") @db.Uuid
  delivery               Delivery?         @relation(fields: [tenantId, orderId], references: [tenantId, orderId], onDelete: Restrict)
  orderItem              OrderItem?        @relation(fields: [tenantId, orderId, productId], references: [tenantId, orderId, productId], onDelete: Restrict)
  reason                 String
  recordedByMembershipId String            @map("recorded_by_membership_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  recordedBy Membership @relation(fields: [tenantId, recordedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, requestId])
  @@unique([tenantId, orderId, productId])
  @@index([tenantId, productId, createdAt, id])
  @@index([tenantId, recordedByMembershipId])
  @@map("stock_movements")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

model Order {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String      @map("tenant_id") @db.Uuid
  customerId            String      @map("customer_id") @db.Uuid
  createdByMembershipId String      @map("created_by_membership_id") @db.Uuid
  requestId             String      @map("request_id") @db.Uuid
  requestHash           String      @map("request_hash")
  status                OrderStatus @default(DRAFT)
  version               Int         @default(1)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  confirmedAt             DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  confirmedByMembershipId String?            @map("confirmed_by_membership_id") @db.Uuid
  confirmedTaxVersion     Int?               @map("confirmed_tax_version")
  acceptedTaxRateBps      Int?               @map("accepted_tax_rate_bps")
  subtotalCents           Int?               @map("subtotal_cents")
  taxCents                Int?               @map("tax_cents")
  /// Up to 4294967294 cents; serialized as a safe JSON number.
  totalCents              BigInt?            @map("total_cents")
  customerCompanyName     String?            @map("customer_company_name")
  confirmedBy             Membership?        @relation("ConfirmedBy", fields: [tenantId, confirmedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  reservations            StockReservation[]

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  createdBy    Membership    @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  items        OrderItem[]
  cancellation Cancellation?
  delivery     Delivery?

  @@unique([tenantId, id])
  @@unique([tenantId, requestId])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, customerId])
  @@index([tenantId, createdByMembershipId])
  @@index([tenantId, confirmedByMembershipId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  productName    String @map("product_name")
  productSku     String @map("product_sku")

  reservation      StockReservation?
  deliveryMovement StockMovement?

  order   Order   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, orderId, productId])
  @@index([tenantId, productId])
  @@map("order_items")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model StockReservation {
  tenantId   String            @map("tenant_id") @db.Uuid
  orderId    String            @map("order_id") @db.Uuid
  productId  String            @map("product_id") @db.Uuid
  status     ReservationStatus @default(ACTIVE)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  releasedAt DateTime?         @map("released_at") @db.Timestamptz(3)
  quantity   Int
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  orderItem OrderItem @relation(fields: [tenantId, orderId, productId], references: [tenantId, orderId, productId], onDelete: Restrict)

  @@id([tenantId, orderId, productId])
  @@index([tenantId, productId])
  @@map("stock_reservations")
}

model Delivery {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  orderId                 String   @map("order_id") @db.Uuid
  deliveredByMembershipId String   @map("delivered_by_membership_id") @db.Uuid
  deliveredAt             DateTime @default(now()) @map("delivered_at") @db.Timestamptz(3)

  order       Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  deliveredBy Membership      @relation(fields: [tenantId, deliveredByMembershipId], references: [tenantId, id], onDelete: Restrict)
  movements   StockMovement[]

  @@unique([tenantId, orderId])
  @@index([tenantId, deliveredByMembershipId])
  @@map("deliveries")
}

model Cancellation {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  orderId                 String   @map("order_id") @db.Uuid
  cancelledByMembershipId String   @map("cancelled_by_membership_id") @db.Uuid
  cancelledAt             DateTime @default(now()) @map("cancelled_at") @db.Timestamptz(3)
  /// Non-blank cancellation reason, at most 500 characters; constrained in SQL.
  reason                  String

  order       Order      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  cancelledBy Membership @relation(fields: [tenantId, cancelledByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, orderId])
  @@index([tenantId, cancelledByMembershipId])
  @@map("cancellations")
}
