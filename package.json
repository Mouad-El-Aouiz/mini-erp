{
  "name": "mini-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "db:create-dev-user": "node --conditions=react-server --import tsx scripts/create-dev-user.ts",
    "test:e2e": "playwright test",
    "db:create-dev-company": "node --conditions=react-server --import tsx scripts/create-dev-company.ts",
    "test:unit": "node --conditions=react-server --import tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "better-auth": {
      "mysql2": "3.24.5"
    },
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
